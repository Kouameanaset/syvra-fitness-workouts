# Copy this file to ".env" and fill in your real values.
# ".env" is ignored by git, so your password never reaches the repository.

# Connection string from the Neon dashboard (Connect button).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Port the API listens on locally (Render sets PORT by itself in production).
PORT=3000

# Front-end origin allowed to call the API (CORS).
# Use http://localhost:5173 locally and your Vercel URL in production.
CORS_ORIGIN=http://localhost:5173
